# Vite output: the filename includes a content hash, so the file never changes
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Per-genome data: no hash in the name, but it rarely changes
/genome-data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Images, CSS and the favicon: no hash, may change with a redeploy
/images/*
  Cache-Control: public, max-age=86400
/*.css
  Cache-Control: public, max-age=3600
/favicon.ico
  Cache-Control: public, max-age=604800
